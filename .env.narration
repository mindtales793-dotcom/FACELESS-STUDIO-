# Configuração do servidor de narração (DarkCut / Fish Audio)
# Copie este arquivo para .env e configure sua chave real

# Chave da API Fish Audio (OBRIGATÓRIO - nunca compartilhe este arquivo)
FISH_API_KEY=COLOQUE_SUA_CHAVE_AQUI

# Modelo padrão (s2.1-pro-free para avaliação, s2.1-pro para produção paga)
FISH_MODEL=s2.1-pro-free

# Concorrência: blocos gerados simultaneamente (comece com 3)
NARRATION_CONCURRENCY=3

# Tamanho máximo aproximado de cada bloco de texto (caracteres)
NARRATION_CHUNK_CHARS=450

# Diretórios persistentes para áudios em cache e narrações finais
NARRATION_CACHE_DIR=./data/narration-cache
NARRATION_OUTPUT_DIR=./data/narrations

# Porta do servidor de narração (Node.js)
PORT=3115
