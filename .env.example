# Bancos de vídeos/fotos (adicione apenas as chaves dos serviços que você ativar)
PEXELS_API_KEY=sua_chave_pexels
PIXABAY_API_KEY=sua_chave_pixabay
UNSPLASH_ACCESS_KEY=sua_chave_unsplash
COVERR_API_KEY=sua_chave_coverr

# Storyblocks: credenciais separadas; a Secret Key permanece somente no servidor
STORYBLOCKS_API_KEY=sua_chave_storyblocks
STORYBLOCKS_API_SECRET=sua_secret_storyblocks

# Fish Audio: geração de narração e prévia de voz
FISH_API_KEY=sua_chave_fish_audio

# Google Flow (IA): imagem Nano Banana e vídeo Veo pela Gemini API. Veo é pago.
GEMINI_API_KEY=sua_chave_gemini
# Modelo textual usado somente como fallback para interpretar cenas
GEMINI_TEXT_MODEL=gemini-2.5-flash
# FLOW_IMAGE_MODEL=gemini-2.5-flash-image

# OpenRouter: interpreta cada cena para gerar termos de busca visuais e nota de movimento.
# Se falhar, o estúdio tenta Gemini e depois a busca tradicional.
OPENROUTER_API_KEY=sua_chave_openrouter
OPENROUTER_MODEL=google/gemini-2.5-flash
# Modelo multimodal separado para comparar miniaturas com cada fala.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# FLOW_IMAGE_MODEL=gemini-2.5-flash-image
# FLOW_VIDEO_MODEL=veo-3.1-fast-generate-preview

# Recomendado: defina uma senha forte para proteger o painel publicado
APP_PASSWORD=troque_por_uma_senha_forte
# Opcional: segredo que assina o cookie de login (se vazio, usa a própria senha). Use um texto longo e aleatório.
# SESSION_SECRET=

# Limites de operação
MAX_UPLOAD_MB=800
MAX_MEDIA_MB=250
MAX_SCENES=120
# Quantos vídeos montam ao mesmo tempo (o resto espera na fila). 1 é o ideal para um PC comum.
MAX_CONCURRENT_RENDERS=1
PIXABAY_SCENE_SEARCH_LIMIT=12
UNSPLASH_SCENE_SEARCH_LIMIT=25
COVERR_SCENE_SEARCH_LIMIT=30
# DATA_DIR=/caminho/persistente/data

# Groq (Whisper): transcricao da narracao com horarios por palavra (SRT exato)
GROQ_API_KEY=sua_chave_groq
# GROQ_MAX_UPLOAD_MB=250
# GROQ_MAX_ACTIVE_JOBS=2
