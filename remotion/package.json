{
  "name": "faceless-remotion",
  "version": "1.1.0",
  "description": "Renderizador de cenas animadas do Faceless Cloud Studio com Remotion",
  "private": true,
  "scripts": {
    "render": "node render.js ./props.json ./out/video.mp4",
    "bundle": "remotion bundle src/index.ts build",
    "browser:ensure": "remotion browser ensure",
    "check": "node --check render.js"
  },
  "dependencies": {
    "@remotion/renderer": "4.0.541",
    "remotion": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@types/react": "19.2.2",
    "typescript": "5.6.3"
  }
}
